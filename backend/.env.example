# Plantilla -- copiar a .env y rellenar con valores reales, nunca comitear .env.
# Detalle de cada variable: RUP/03-diseño/README.md#configuracion

# dev | prod. En dev se acepta la cabecera X-Dev-User como identidad del
# personal (sustituto temporal de OAuth). En prod esa cabecera se ignora.
PULSO_ENV=dev

DATABASE_URL=sqlite:///./pulso.db

# Secreto HMAC con el que se almacenan los codigos de invitacion.
# Generar con: openssl rand -hex 32
CODIGO_PEPPER=

# Emails (separados por comas) con rol Gestor de calidad.
GESTORES_EMAILS=

# Origen del frontend permitido por CORS.
FRONTEND_URL=http://localhost:5173

# Fichero JSON del catalogo CELDA simulado (v1 sin integracion real).
CELDA_STUB_PATH=app/data/celda_stub.json
