# Plantilla -- copiar a .env y rellenar con valores reales, nunca comitear .env.
# Detalle de cada variable: RUP/03-diseño/README.md#configuracion

# dev | prod. En dev se acepta la cabecera X-Dev-User como identidad del
# personal (sustituto temporal de OAuth). En prod esa cabecera se ignora.
# Si falta la variable, se asume prod. Para desarrollo local: PULSO_ENV=dev.
PULSO_ENV=prod

DATABASE_URL=sqlite:///./pulso.db

# Secreto HMAC con el que se almacenan los codigos de invitacion.
# Generar con: openssl rand -hex 32
CODIGO_PEPPER=

# Firma de la cookie de sesion del personal (>= 32 caracteres fuera de dev).
# Generar con: openssl rand -hex 32
SESSION_SECRET=

# Cuenta de acceso (rol Gestor de calidad). La contrasena NUNCA en claro:
# ACCESO_CLAVE_HASH se genera con `python3 -m app.core.claves`.
# El hash contiene `$`: escribirlo SIEMPRE entre comillas simples ('...').
# Sirve igual para systemd (EnvironmentFile retira las comillas) y para
# `source`. Con comillas dobles, `source` expande los `$` y el login falla.
ACCESO_USUARIO=
ACCESO_CLAVE_HASH=

# Emails (separados por comas) con rol Gestor de calidad (cabecera X-Dev-User
# en dev, para tests y curl).
GESTORES_EMAILS=

# Origen del frontend permitido por CORS.
FRONTEND_URL=http://localhost:5173

# Fichero JSON del catalogo simulado (v1 sin integracion real con CELDA):
# catalogo publico de UNIB, ver scripts/generar_catalogo_unib.py.
CELDA_STUB_PATH=app/data/celda_stub.json
